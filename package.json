{
  "name": "@designerpawssalon/trianglify",
  "version": "5.0.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Trianglify is a javascript library for generating colorful triangle meshes that can be used as SVG images and CSS backgrounds.",
  "type": "module",
  "sideEffects": [
    "./dist/trianglify.worker.js"
  ],
  "main": "dist/trianglify.cjs",
  "module": "dist/trianglify.browser.mjs",
  "types": "dist/trianglify.d.cts",
  "typesVersions": {
    "*": {
      "worker": [
        "./dist/trianglify.worker.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/trianglify.d.ts",
        "default": "./dist/trianglify.browser.mjs"
      },
      "import": {
        "types": "./dist/trianglify.d.ts",
        "default": "./dist/trianglify.mjs"
      },
      "require": {
        "types": "./dist/trianglify.d.cts",
        "default": "./dist/trianglify.cjs"
      },
      "default": "./dist/trianglify.mjs"
    },
    "./worker": {
      "types": "./dist/trianglify.worker.d.ts",
      "default": "./dist/trianglify.worker.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint src/ scripts/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node scripts/check-dist.mjs && jest",
    "test:coverage": "node scripts/check-dist.mjs && jest --coverage",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && rollup -c && node scripts/postbuild.mjs",
    "dev": "tsc -p tsconfig.build.json && rollup -c -w",
    "prepublishOnly": "pnpm run ci",
    "publish-beta": "pnpm run build && pnpm publish --tag next",
    "lint:package": "publint && attw --pack . --exclude-entrypoints ./worker && tsc -p typetests",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run lint:package && pnpm run test:coverage"
  },
  "peerDependencies": {
    "canvas": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "canvas": {
      "optional": true
    }
  },
  "files": [
    "dist/",
    "Readme.md",
    "MIGRATING.md",
    "changelog.txt",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IDontKnowMyUsername/trianglify.git"
  },
  "keywords": [
    "svg",
    "canvas",
    "visualization",
    "pattern",
    "lowpoly",
    "low-poly",
    "trianglify",
    "triangle",
    "delaunay",
    "generative",
    "background",
    "typescript"
  ],
  "jest": {
    "coverageProvider": "v8",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "setupFiles": [
      "jest-canvas-mock"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "dist/trianglify.cjs",
      "!src/**/*.test.ts",
      "!src/**/*.d.ts",
      "!src/types.ts",
      "!src/worker.ts"
    ],
    "coveragePathIgnorePatterns": [
      "node_modules",
      "\\.test\\.ts$",
      "dist/trianglify\\.bundle"
    ],
    "coverageReporters": [
      "clover",
      "json",
      "lcov",
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "./src/": {
        "statements": 98,
        "branches": 95,
        "functions": 98,
        "lines": 98
      },
      "./src/**/*.ts": {
        "statements": 90,
        "branches": 80,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "author": "Quinn Rohlf <qr@qrohlf.com>",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "bugs": {
    "url": "https://github.com/IDontKnowMyUsername/trianglify/issues"
  },
  "homepage": "https://github.com/IDontKnowMyUsername/trianglify",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "canvas": "^3.2.2",
    "culori": "^4.0.2",
    "delaunator": "^5.1.0",
    "eslint": "^10.1.0",
    "jest": "^30.3.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.3.0",
    "publint": "^0.3.22",
    "rollup": "^4.60.0",
    "rollup-plugin-bundle-size": "^1.0.3",
    "rollup-plugin-dts": "^6.4.1",
    "ts-jest": "29.4.6",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.57.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas"
    ]
  }
}
